+
+# This is also required for Traefik k8s charm to work in routing mode
+# path. The reason is that when the proxied url is something like
+# http://url/path, the url called by the ingress is really
+# http://service/, without the path.  See also
+# https://github.com/evansd/whitenoise/issues/271
+#
+# The trailing slash is stripped from the ingress path because STATIC_URL
+# already starts with "/". Without this, a root ingress path ("/") gives
+# "///static/", which Python >= 3.14 urljoin no longer collapses (#128).
+_base_path = urlparse(os.environ.get('DJANGO_BASE_URL', '/')).path.rstrip('/')
+
+WHITENOISE_STATIC_PREFIX = STATIC_URL
+STATIC_URL = f"{_base_path}{STATIC_URL}"   # "/static/" or "/prefix/static/"
+FORCE_SCRIPT_NAME = _base_path
+MEDIA_URL = f"{_base_path}{MEDIA_URL}"
